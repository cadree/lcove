# Copy to .env for local development. Leave the values empty in git.
# Vite reads these at dev and build time and inlines them into the client.
# On Cloudflare Pages, Netlify, or Vercel, set the same names in the host's
# environment settings. A committed .env file is not used.
#
# VITE_SUPABASE_PUBLISHABLE_KEY is the anon (public) key.
# Never put the service role key in a VITE_ variable.

VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PROJECT_ID=
