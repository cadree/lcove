# Copy to .env for local development. Leave the values empty in git.
# Vite reads these at dev and build time and inlines them into the client.
# On Cloudflare Pages, set them in the host's environment settings.
# Production (etherbylcove.com, branch cursor/ether-combined) uses ether-prod.
# Preview must use a different Supabase project. See docs/preview-staging.md.
# A committed .env file is not used.
#
# VITE_SUPABASE_PUBLISHABLE_KEY is the anon (public) key.
# The production build writes these public values into dist/event-share-config.json.
# Pages Functions read that file. They do not read runtime environment variables.
# Never put the service role key, a VAPID private key, or any other secret
# in a VITE_ variable.

VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PROJECT_ID=

# Web Push public key. The private key is a Supabase secret named VAPID_PRIVATE_KEY.
# Generate a pair with: npx web-push generate-vapid-keys
# See docs/push-setup.md.
VITE_VAPID_PUBLIC_KEY=

# Set to true only after generate-wallet-pass is configured. Hidden otherwise.
VITE_WALLET_PASSES_ENABLED=false
