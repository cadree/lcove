	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>app.lovable.e07d9c457fd949f78f3cc7d5998be668</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>app.lovable.e07d9c457fd949f78f3cc7d5998be668</string>
			</array>
		</dict>
	</array>
	<key>NSCameraUsageDescription</key>
	<string>Ether uses the camera when you go live and when you scan an event check-in code.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>Ether uses the microphone so people can hear you during a live stream.</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>Ether uses your photo library when you choose a picture for your profile, a post, an event, a message, or another upload.</string>
	<!-- iOS has no usage-description key for notifications. The system permission
	     dialog does not take a custom sentence. Ether asks so it can deliver
	     messages, event reminders, and community alerts. Remote delivery needs
	     APNs, which requires a paid Apple Developer account. -->
	<key>UIBackgroundModes</key>
	<array>
		<string>remote-notification</string>
	</array>
